{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterdarksys.com/schemas/enforcement-policy-v1.json",
  "title": "AfterDark endpoint enforcement policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "mode", "registries", "verification", "enforcement"],
  "properties": {
    "apiVersion": { "const": "afterdark.dev/v1alpha1" },
    "mode": { "const": "enforce" },
    "registries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "tufRootSha256"],
        "properties": {
          "origin": { "type": "string", "format": "uri", "pattern": "^https://" },
          "tufRootSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireDigest", "requireSignature", "requireProvenance", "allowedSignerIdentities"],
      "properties": {
        "requireDigest": { "const": true },
        "requireSignature": { "const": true },
        "requireProvenance": { "const": true },
        "allowedSignerIdentities": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denyUnmanaged", "denyUpstreamNetwork", "quarantineNoncompliant", "managedSkillRoots"],
      "properties": {
        "denyUnmanaged": { "const": true },
        "denyUpstreamNetwork": { "const": true },
        "quarantineNoncompliant": { "type": "boolean" },
        "managedSkillRoots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["client", "path"],
            "properties": {
              "client": { "enum": ["codex", "claude", "openclaw", "generic"] },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
