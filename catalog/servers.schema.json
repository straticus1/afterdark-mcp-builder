{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterdarksys.com/schemas/mcp-catalog-v1.json",
  "title": "AfterDark MCP catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "servers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "description", "tags", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "supported", "deprecated"] },
        "description": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "revision"],
          "properties": {
            "type": { "const": "git" },
            "url": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executables": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "macosCask": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "package", "version", "bin", "integrity"],
          "properties": {
            "type": { "const": "npm" },
            "package": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "bin": { "type": "string", "minLength": 1 },
            "integrity": { "type": "string", "pattern": "^sha512-" }
          }
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "args"],
          "properties": {
            "transport": { "const": "stdio" },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        },
        "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
