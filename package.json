{
  "name": "afterdark-mcp-builder-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "catalog:skills": "npm run build --workspace @afterdark/mcp-builder && node scripts/build-skill-candidates.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test test/*.test.mjs"
  }
}
