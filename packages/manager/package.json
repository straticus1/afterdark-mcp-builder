{
  "name": "@afterdark/mcp-builder",
  "version": "2.0.0",
  "description": "Curated MCP plugin manager, supervisor, and unified gateway CLI.",
  "author": "dwilcox",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "mcp-builder": "./dist/cli.js",
    "mcp-manager": "./dist/cli.js",
    "mcpm": "./dist/cli.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-catalog.mjs",
    "build:watch": "tsc --watch",
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "cli",
    "agent",
    "mcp-builder",
    "mcpm"
  ]
}
