# mcp-manager environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Core ─────────────────────────────────────────────────────────────────────
FS_ROOT=/path/to/your/project
GIT_REPO=/path/to/your/project
PROCESS_CWD=/path/to/your/project

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_changeme

# ── Databases ────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://user:pass@localhost:5432/mydb
SQLITE_DB_PATH=/path/to/database.sqlite

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=changeme

# ── Vector / RAG ─────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=changeme
PINECONE_API_KEY=changeme
PINECONE_ENV=us-east-1

# ── Cache / Queue ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloud ─────────────────────────────────────────────────────────────────────
AWS_PROFILE=default
AWS_REGION=us-east-1

# ── Orchestration ─────────────────────────────────────────────────────────────
N8N_URL=https://n8n.example.com/api/v1
N8N_API_KEY=changeme

# ── Search ────────────────────────────────────────────────────────────────────
BRAVE_API_KEY=changeme
